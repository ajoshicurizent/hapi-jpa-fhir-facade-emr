# Copy to .env on the droplet and edit values.
# Do NOT commit real secrets.

POSTGRES_DB=hapi
POSTGRES_USER=hapi
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Public FHIR base URL (no trailing slash issues beyond /fhir)
HAPI_FHIR_SERVER_ADDRESS=https://fhirserver.curizent.com/fhir

# Hostname used by Caddy for HTTPS
FHIR_HOSTNAME=fhirserver.curizent.com
